alias ls='ls --color=auto'
alias u=ultralist
alias mux=tmuxinator
alias del='~/dotfiles/sybox-config/del'
alias setup='~/dotfiles/sybox-config/setup'
alias setw='~/dotfiles/sybox-config/setw'
alias up='source ~/.zshrc'
